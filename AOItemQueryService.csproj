<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x86</PlatformTarget>
	<RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
<ItemGroup>
    <PackageReference Include="AODB" Version="1.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.8" />
</ItemGroup>
<ItemGroup>
  <Reference Include="AOSharp.Common">
    <HintPath>..\AOSharp.Net\bin\Release\net10.0-windows\Plugins\AOSharp.Common\AOSharp.Common.dll</HintPath>
  </Reference>
  <Reference Include="AOSharp.Core">
    <HintPath>..\AOSharp.Net\bin\Release\net10.0-windows\Plugins\AOSharp.Core\AOSharp.Core.dll</HintPath>
  </Reference>
</ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ItemDb\ItemRelations.csv" LogicalName="ItemRelations.csv" />
    <!-- The builder is its own program; it is built below, not compiled into the service. -->
    <Compile Remove="ItemDbBuild\**" />
    <None Remove="ItemDbBuild\**" />
  </ItemGroup>

  <!--
    The database is built by ItemDbBuild in its own process. Build it into builder\ next to the
    service, so the loader ships it with the service's output.
  -->
  <Target Name="BuildItemDbBuilder" AfterTargets="Build">
    <MSBuild Projects="ItemDbBuild\ItemDbBuild.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);MSBuildRestoreSessionId=$([System.Guid]::NewGuid())"
             RemoveProperties="RuntimeIdentifier;PlatformTarget;Platform" />
    <MSBuild Projects="ItemDbBuild\ItemDbBuild.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);OutDir=$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)', 'builder'))\"
             RemoveProperties="RuntimeIdentifier;PlatformTarget;Platform" />
  </Target>
</Project>