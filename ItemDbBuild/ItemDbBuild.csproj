<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the item database in its own process, so the game never carries the
    work. AOItemQueryService builds this into its own output under builder\ and
    starts it when the database needs building.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AODB" Version="1.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.8" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ItemDb\*.cs" Link="ItemDb\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\ItemDb\ItemRelations.csv" LogicalName="ItemRelations.csv" />
  </ItemGroup>
</Project>
